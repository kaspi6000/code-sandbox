{
  "name": "code-sandbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "web:dev": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "turbo": "^2.8.3"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    }
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  }
}
