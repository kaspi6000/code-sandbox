{
  "name": "code-sandbox",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "web:dev": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "turbo": "^2.8.3"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    }
  }
}
